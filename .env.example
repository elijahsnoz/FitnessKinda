# FitnessKinda — copy to .env for local work. Nothing here is committed.

# Local development needs none of this: with no TURSO_DATABASE_URL the app uses
# a plain SQLite file under DATA_DIR.

PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Production database (Turso). The token is a secret.
# TURSO_DATABASE_URL=libsql://fitnesskinda-you.turso.io
# TURSO_AUTH_TOKEN=

# Vercel sets this itself in production; it marks the session cookie Secure.
# NODE_ENV=production

# Origins allowed to make writes. Leave blank locally and the Origin header must
# simply match the request Host.
# ALLOWED_ORIGINS=https://fitnesskinda.fit

# Accounts that may open /admin. Admin cannot be granted from inside the app.
ADMIN_EMAILS=

SESSION_DAYS=30

# 1 logs method, route pattern and status. Never bodies or health data.
ACCESS_LOG=0
