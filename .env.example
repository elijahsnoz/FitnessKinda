# FitnessKinda. Copy to .env for local work. Nothing here is committed.

# Local development needs none of this: with no TURSO_DATABASE_URL the app uses
# a plain SQLite file under DATA_DIR, and with no RESEND_API_KEY it logs the
# verification link instead of sending it.

PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Production database (Turso). The token is a secret.
# TURSO_DATABASE_URL=libsql://fitnesskinda-you.turso.io
# TURSO_AUTH_TOKEN=

# Email (Resend). Without both of these, nothing is sent.
# RESEND_API_KEY=
# EMAIL_FROM=FitnessKinda <hello@fitnesskinda.fit>

# Where verification links point. Without it, the request's own origin is used.
# PUBLIC_URL=https://www.fitnesskinda.fit

# Bump when the terms change materially; it is recorded against each sign-up.
TERMS_VERSION=2026-09-20

# Vercel sets this itself in production; it marks the session cookie Secure.
# NODE_ENV=production

# Origins allowed to make writes.
# ALLOWED_ORIGINS=https://www.fitnesskinda.fit

# Accounts that may open /admin. Admin cannot be granted from inside the app.
ADMIN_EMAILS=

SESSION_DAYS=30

# 1 logs method, route pattern and status. Never bodies or health data.
ACCESS_LOG=0
