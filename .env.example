# FitnessKinda — copy to .env and adjust. Nothing here is committed.

# Where the app listens.
PORT=3000
HOST=0.0.0.0

# Directory holding the SQLite file. On a host with a mounted volume, point this at it.
DATA_DIR=./data

# Turns on Secure cookies. Set this in production, where TLS terminates in front.
NODE_ENV=production

# Comma-separated origins allowed to make writes. Leave blank to require that the
# Origin header simply matches the request Host, which is right for a single domain.
ALLOWED_ORIGINS=https://fitnesskinda.fit

# Accounts that may open /admin. Admin cannot be granted from inside the app.
ADMIN_EMAILS=

# How long a session lasts.
SESSION_DAYS=30

# Set to 1 to log method, route pattern and status. Never logs bodies or health data.
ACCESS_LOG=0
